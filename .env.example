# Siren ThreatWatch configuration — copy to `.env` and edit. NEVER commit your real .env file.
# Every setting is optional; the defaults work for a local, no-API-key install.

# ---------- Storage ----------
# SQLite (default). For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/siren
SIREN_DATABASE_URL=sqlite:///data/siren.db
SIREN_DATA_DIR=data

# ---------- Logging ----------
SIREN_LOG_LEVEL=INFO
# true = structured JSON lines, false = human-readable
SIREN_LOG_JSON=false

# ---------- HTTP safety limits ----------
SIREN_HTTP_TIMEOUT_SECONDS=30
SIREN_HTTP_MAX_RETRIES=3
SIREN_HTTP_MAX_RESPONSE_MB=50
SIREN_HTTP_MAX_CONCURRENCY=4

# ---------- CISA KEV (no API key needed) ----------
SIREN_KEV_ENABLED=true
# Official feed and CISA's official GitHub mirror (used as a fallback). Hosts must be allowlisted.
SIREN_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
SIREN_KEV_MIRROR_URL=https://raw.githubusercontent.com/cisagov/kev-data/main/known_exploited_vulnerabilities.json

# ---------- Scheduling (optional, used by `siren schedule`) ----------
SIREN_SCHEDULE_INTERVAL_MINUTES=360

# ---------- Prioritization ----------
# Comma-separated vendor/product keywords relevant to YOUR organisation (raise priority when matched).
SIREN_ORG_RELEVANT_KEYWORDS=
# Score at/above which new records raise a "new high-priority" alert (0-100)
SIREN_ALERT_MIN_SCORE=60

# ---------- Credentials for future-phase connectors (leave blank to keep them disabled) ----------
# These are read but NOT yet used in Phase 1. They are never logged or displayed.
NVD_API_KEY=
OTX_API_KEY=
ABUSECH_AUTH_KEY=
